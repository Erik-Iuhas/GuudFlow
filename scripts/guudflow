#!/usr/bin/env python3
"""Convenience launcher for the GuudFlow CLI.

Equivalent to `python -m cli ...`. Symlink or alias this onto your
PATH for a `guudflow` command without installing the package.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from cli.main import main


if __name__ == "__main__":
    raise SystemExit(main())
