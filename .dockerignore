# Keep the build context small — exclude things the image doesn't need.

# Python local state
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.tox/
.coverage
htmlcov/

# Node
studio/node_modules/
studio/dist/
node_modules/

# Local runtime data (mounted at runtime, not baked in). The shipped assets in
# data/ (models.json, _seed/, example_projects/, role_templates/, manifestos/,
# teams/, training_camp/) stay in the image: the app reads them from /app/data.
data/runs/
data/projects/
data/projects.json
data/personas/
data/model_config.json
data/secrets/
data/tmp/
data/*.log

# Local tool installs (the image installs its own pinned opencode)
.tools/
.tmp_*

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docs / planning that don't affect runtime
.claude/
*.log

# Local secrets
.env
*.env.local
