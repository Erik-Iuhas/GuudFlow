# Keep the build context small — exclude things the image doesn't need.

# Python local state
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.tox/
.coverage
htmlcov/

# Node
studio/node_modules/
studio/dist/
node_modules/

# Local data and runs (mounted at runtime, not baked in)
data/
.tmp_*

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docs / planning that don't affect runtime
.claude/
*.log

# Local secrets
.env
*.env.local
