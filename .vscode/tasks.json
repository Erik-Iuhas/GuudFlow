{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install uv",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "install-uv"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "install-uv"
        ]
      }
    },
    {
      "label": "Setup (venv, packages, Studio, .env)",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "dependsOn": [
        "Install uv"
      ],
      "args": [
        "scripts/run.sh",
        "setup"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "setup"
        ]
      }
    },
    {
      "label": "Stop dev stack",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "stop"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "stop"
        ]
      }
    },
    {
      "label": "Doctor (is this machine ready?)",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "doctor"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "doctor"
        ]
      }
    },
    {
      "label": "Run dev stack (API :8000 + Studio :3001)",
      "type": "process",
      "command": "bash",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      },
      "dependsOn": [
        "Install uv"
      ],
      "args": [
        "scripts/run.sh",
        "dev"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "dev"
        ]
      }
    },
    {
      "label": "Run dev stack (no reload, safe for agent runs)",
      "type": "process",
      "command": "bash",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      },
      "dependsOn": [
        "Install uv"
      ],
      "args": [
        "scripts/run.sh",
        "dev",
        "--no-reload"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "dev",
          "--no-reload"
        ]
      }
    },
    {
      "label": "Run API (built Studio on :8000)",
      "type": "process",
      "command": "bash",
      "dependsOn": [
        "Build Studio"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "api"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "api"
        ]
      }
    },
    {
      "label": "Docker Compose up",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "Docker Compose logs",
      "type": "shell",
      "command": "docker compose logs -f --tail=100",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker Compose down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "Build Studio",
      "type": "process",
      "command": "bash",
      "problemMatcher": [
        "$tsc"
      ],
      "args": [
        "scripts/run.sh",
        "build",
        "studio"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "build",
          "studio"
        ]
      }
    },
    {
      "label": "Build for the Python path (Studio + opencode)",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "build",
        "native"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "build",
          "native"
        ]
      }
    },
    {
      "label": "Install opencode",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "install-opencode"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "install-opencode"
        ]
      }
    },
    {
      "label": "Check: everything fast",
      "type": "process",
      "command": "bash",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "check"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "check"
        ]
      }
    },
    {
      "label": "Check: backend",
      "type": "process",
      "command": "bash",
      "group": "test",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "check",
        "backend"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "check",
          "backend"
        ]
      }
    },
    {
      "label": "Check: Studio",
      "type": "process",
      "command": "bash",
      "group": "test",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "check",
        "studio"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "check",
          "studio"
        ]
      }
    },
    {
      "label": "Check: escape suite (Docker, root)",
      "type": "process",
      "command": "bash",
      "group": "test",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "check",
        "escape"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "check",
          "escape"
        ]
      }
    },
    {
      "label": "Build Docker image",
      "type": "process",
      "command": "bash",
      "problemMatcher": [],
      "args": [
        "scripts/run.sh",
        "build",
        "docker"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "build",
          "docker"
        ]
      }
    },
    {
      "label": "Studio: install npm packages (retries, mirror, relaxed versions)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/run.sh",
        "studio-deps"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "studio-deps"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Studio: pack the build into studio-dist.tar.gz",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/run.sh",
        "studio-pack",
        "studio-dist.tar.gz"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "studio-pack",
          "studio-dist.tar.gz"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Studio: unpack a prebuilt studio-dist.tar.gz",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/run.sh",
        "studio-unpack",
        "${input:studioArchive}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/run.ps1",
          "studio-unpack",
          "${input:studioArchive}"
        ]
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "studioArchive",
      "type": "promptString",
      "description": "Path to the prebuilt Studio archive (relative to the repo, or absolute)",
      "default": "studio-dist.tar.gz"
    }
  ]
}
