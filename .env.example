# GuudFlow settings. See docs/SETUP.md.
# The API loads this file over your shell environment: an EMPTY line erases a value you
# exported. Fill a line in or delete it.

# Model key (or delete this line and paste the key in Studio: Settings → Models & providers).
ANTHROPIC_API_KEY=
# Bearer token for the API and Studio. Set it, even locally.
GUUDFLOW_API_TOKEN=
GUUDFLOW_MODE=dev
GUUDFLOW_DATA_DIR=./data
# Seconds to wait for each agent's opencode server to start (default 180; raise it on slow disks).
# GUUDFLOW_OPENCODE_STARTUP_S=180
# Where agents run: auto (Docker when available), docker, or host (no sandbox; trusted work only).
# GUUDFLOW_SANDBOX=auto

# A custom certificate authority (company proxy, internal model endpoint): a PEM file trusted in
# addition to the public roots, by GuudFlow, git, npm and opencode, and by the setup tasks (uv,
# pip, npm, curl). TLS checks stay on. A Windows path (C:\certs\corp-ca.pem) also works in WSL.
# GUUDFLOW_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# Proxy for the setup tasks and the API (the tasks read these lines too).
# HTTPS_PROXY=http://proxy.example.corp:8080
# NO_PROXY=localhost,127.0.0.1
# PyPI mirror for the Python packages.
# GUUDFLOW_PIP_INDEX=https://pypi.example.corp/simple

# npm mirror for Studio's packages (a company registry), if npm's own config does not set one.
# GUUDFLOW_NPM_REGISTRY=https://npm.example.corp/

# Docker Compose only: absolute host path for the data directory (default: ./data in the repo).
# GUUDFLOW_HOST_DATA=/srv/guudflow
# Docker Compose only: where the API listens (host networking). 0.0.0.0 exposes it on every interface.
# GUUDFLOW_BIND=127.0.0.1
